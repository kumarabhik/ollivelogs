# =========================================================
# OlliveLogs — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# =========================================================

# ---------- App ----------
APP_ENV=local                              # local | staging | prod
LOG_LEVEL=INFO
WEB_PORT=3000
CHAT_API_PORT=8001
INGEST_API_PORT=8002
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
CHAT_API_PROXY_TARGET=                    # optional: point web /api/v1/* routes at a live chat-api

# ---------- Auth ----------
SESSION_SECRET=change-me-to-32-bytes-of-randomness
ALLOW_ANONYMOUS=true
SESSION_COOKIE_NAME=ollive_session
SESSION_TTL_SECONDS=2592000
SESSION_COOKIE_SECURE=false

# ---------- Postgres ----------
POSTGRES_USER=ollive
POSTGRES_PASSWORD=ollive
POSTGRES_DB=ollivelogs
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ollive:ollive@postgres:5432/ollivelogs

# ---------- ClickHouse ----------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=ollivelogs

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
EVENT_BUS_STREAM=logs.raw
EVENT_BUS_DLQ=logs.dlq
EVENT_BUS_CONSUMER_GROUP=cg-store

# ---------- Ingest / SDK ----------
OLLIVE_INGEST_URL=http://ingest-api:8002/v1/logs
OLLIVE_SDK_BATCH_SIZE=50
OLLIVE_SDK_FLUSH_MS=200
OLLIVE_SDK_QUEUE_MAX=1000

# ---------- Demo seed data ----------
OLLIVE_SEED_DATASET_ENABLED=true
OLLIVE_SEED_DATASET_PATH=
OLLIVE_SEED_DATASET_LIMIT=6
OLLIVE_SEED_DATASET_MODEL=Qwen/Qwen2.5-72B-Instruct

# ---------- PII redaction ----------
PII_REDACTION_ENABLED=true
STORE_RAW=false
RAW_ENCRYPTION_KEY=change-me-32-bytes
DLQ_SLACK_WEBHOOK_URL=
DLQ_DISCORD_WEBHOOK_URL=
BUDGET_ALERT_THRESHOLD_USD=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
BUDGET_ALERT_FROM_EMAIL=alerts@ollivelogs.local

# ---------- Providers ----------
DEFAULT_PROVIDER=huggingface
DEFAULT_MODEL=Qwen/Qwen2.5-72B-Instruct
PROVIDER_FAILOVER_ENABLED=true
PROVIDER_FAILOVER_MAP=openai=anthropic;anthropic=openai;gemini=openai;deepseek=openai;grok=openai;huggingface=openai
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_TOKENS=1024
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514
GOOGLE_DEFAULT_MODEL=gemini-2.5-flash
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
XAI_DEFAULT_MODEL=grok-beta
HF_DEFAULT_MODEL=Qwen/Qwen2.5-72B-Instruct

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

# HuggingFace (via Inference Router — OpenAI-compatible)
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Grok (xAI)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAMESPACE=ollivelogs
PROMETHEUS_METRICS_PATH=/metrics

# ---------- Rate limits ----------
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_TOKENS_PER_MIN=2000

# ---------- Chat behavior ----------
CHAT_CONTEXT_TURNS=20
STREAM_CHUNK_DELAY_MS=20
CANCEL_TTL_SECONDS=300
